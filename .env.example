# Copy to .env and fill in. .env is ignored by Git; never commit real values.
# Used only by npm run pipeline, stages 5 (clip selection) and 8 (metadata).
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=your-model-id
# Optional: a different model only for the scene plan (stage 5, second call). Defaults to ANTHROPIC_MODEL.
# ANTHROPIC_SCENE_MODEL=your-model-id
# Optional: folder that receives finished videos and their metadata after stage 9. Default: C:\Edit Videos
# POSIBLO_DELIVERY_DIR=C:\Edit Videos
